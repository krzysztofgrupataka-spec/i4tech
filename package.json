{
  "name": "i4tech-sage-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:ts": "eslint resources --max-warnings=0",
    "lint:styles": "stylelint \"resources/styles/**/*.scss\" \"resources/blocks/**/*.scss\"",
    "format": "prettier --write .",
    "new:block": "node scripts/new-block.mjs"
  },
  "dependencies": {
    "@roots/vite-plugin": "^1.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stylistic/eslint-plugin": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^14.0.0",
    "@wordpress/components": "^29.0.0",
    "@wordpress/element": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "lightningcss": "^1.29.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.80.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
