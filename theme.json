{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "yellow-500", "name": "Yellow 500", "color": "#f7bd00" },
        { "slug": "yellow-400", "name": "Yellow 400", "color": "#fdc300" },
        { "slug": "yellow-300", "name": "Yellow 300", "color": "#ffd13d" },
        { "slug": "gray-900", "name": "Gray 900", "color": "#272727" },
        { "slug": "gray-600", "name": "Gray 600", "color": "#404142" },
        { "slug": "gray-400", "name": "Gray 400", "color": "#9e9e9e" },
        { "slug": "gray-100", "name": "Gray 100", "color": "#efeadf" },
        { "slug": "gray-50", "name": "Gray 50", "color": "#faf8f5" },
        { "slug": "primary", "name": "Primary", "color": "#f7bd00" },
        { "slug": "secondary", "name": "Secondary", "color": "#fdc300" },
        { "slug": "accent", "name": "Accent", "color": "#f7bd00" },
        { "slug": "foreground", "name": "Foreground", "color": "#272727" },
        { "slug": "muted", "name": "Muted", "color": "#9e9e9e" },
        { "slug": "background", "name": "Background", "color": "#ffffff" },
        { "slug": "surface", "name": "Surface", "color": "#faf8f5" },
        { "slug": "black", "name": "Black", "color": "#1d1d1b" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "custom": {
      "container": {
        "default": "1560px",
        "wide": "1740px",
        "narrow": "800px"
      }
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1740px"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "2", "name": "2", "size": "0.5rem" },
        { "slug": "4", "name": "4", "size": "1rem" },
        { "slug": "6", "name": "6", "size": "1.5rem" },
        { "slug": "8", "name": "8", "size": "2rem" },
        { "slug": "12", "name": "12", "size": "3rem" },
        { "slug": "16", "name": "16", "size": "4rem" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Inter Tight\", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "Inter Tight",
          "slug": "inter"
        }
      ],
      "fontSizes": [
        { "slug": "caption", "name": "Caption", "size": "0.75rem" },
        { "slug": "body-sm", "name": "Body SM", "size": "0.875rem" },
        { "slug": "body-md", "name": "Body MD", "size": "1rem" },
        { "slug": "label-md", "name": "Label MD", "size": "1rem" },
        { "slug": "body-lg", "name": "Body LG", "size": "1.125rem" },
        { "slug": "heading-4", "name": "Heading H4", "size": "1.125rem" },
        { "slug": "heading-3", "name": "Heading H3", "size": "1.5rem" },
        { "slug": "heading-2", "name": "Heading H2", "size": "2.125rem" },
        { "slug": "heading-1", "name": "Heading H1", "size": "2.5rem" },
        { "slug": "display-3-xl", "name": "Display 3XL", "size": "3.4375rem" },
        { "slug": "display-5-xl", "name": "Display 5XL", "size": "5rem" }
      ],
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--6)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--foreground)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "2rem",
            "bottom": "1rem",
            "left": "2rem"
          }
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  }
}
